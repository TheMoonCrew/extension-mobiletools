<?xml version="1.0" encoding="utf-8"?>
<extension>

	<section if="android">

		<!-- Native Java side of the Android backend -->
		<java path="java" />
		<android extension="com.mobiletools.MobileTools" />

		<!-- Required by MobileTools.vibrate() -->
		<config:android permission="android.permission.VIBRATE" />

		<!--
			Permissions used by `Permissions` (CAMERA, RECORD_AUDIO, ACCESS_FINE_LOCATION, ...) are NOT declared here
			on purpose, so apps only ship the ones they need. Add them in your own project.xml, see the README.
		-->

	</section>

	<section if="ios">

		<!-- The Objective-C++ source is compiled by hxcpp, see IOSNative.hx and project/ios/mobiletools_ios.xml -->
		<dependency name="UIKit.framework" />
		<dependency name="AudioToolbox.framework" />
		<dependency name="AVFoundation.framework" />
		<dependency name="CoreLocation.framework" />
		<dependency name="Photos.framework" />
		<dependency name="MediaPlayer.framework" />
		<dependency name="Contacts.framework" />
		<dependency name="CoreBluetooth.framework" />
		<dependency name="CoreHaptics.framework" />
		<dependency name="CoreMotion.framework" />
		<dependency name="EventKit.framework" />
		<dependency name="LocalAuthentication.framework" />
		<dependency name="AppTrackingTransparency.framework" />
		<dependency name="UserNotifications.framework" />

	</section>

</extension>
